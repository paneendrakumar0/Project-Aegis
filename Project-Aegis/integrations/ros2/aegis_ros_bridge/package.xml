<?xml version="1.0"?>
<package format="3">
  <name>aegis_ros_bridge</name>
  <version>0.1.0</version>
  <description>Replay Project Aegis telemetry into ROS 2 topics for bagging and visualization.</description>
  <maintainer email="maintainer@example.com">Project Aegis</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rosgraph_msgs</depend>
  <depend>aegis_msgs</depend>

  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

